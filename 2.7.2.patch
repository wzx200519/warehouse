+
+  publish-image:
+    name: Publish Docker image
+    needs:
+      - pre-commit
+      - quality
+      - security
+    if: |
+      (github.event_name == 'push' && github.ref == 'refs/heads/main') ||
+      github.event_name == 'workflow_dispatch'
+    runs-on: ubuntu-24.04
