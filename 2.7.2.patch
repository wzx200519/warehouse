+          {
+            echo "image_repository=${IMAGE_REPOSITORY}"
+            echo "image_ref=${IMAGE_REPOSITORY}:sha-${SHORT_SHA}"
+            echo 'tags<<EOF'
+            echo "${IMAGE_REPOSITORY}:sha-${SHORT_SHA}"
+            if [ "${GITHUB_REF_NAME}" = "main" ]; then
+              echo "${IMAGE_REPOSITORY}:main"
+              echo "${IMAGE_REPOSITORY}:latest"
+            fi
+            echo 'EOF'
+          } >> "$GITHUB_OUTPUT"
+      - name: Build and push release image
+        id: build
+        uses: docker/build-push-action@v6
+        with:
+          context: .
+          file: ./Dockerfile
+          push: true
+          tags: ${{ steps.meta.outputs.tags }}
+          labels: |
+            org.opencontainers.image.revision=${{ github.sha }}
+            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
+          cache-from: type=gha,scope=warehouse-release
+          cache-to: type=gha,mode=max,scope=warehouse-release
+
