+      - scan-image
+    if: |
+      needs.publish-image.result == 'success' &&
+      needs.scan-image.result == 'success' &&
+      vars.DEPLOY_REPOSITORY != '' &&
+      secrets.DEPLOY_REPOSITORY_TOKEN != ''
+    runs-on: ubuntu-24.04
+    environment: ${{ vars.DEPLOY_ENVIRONMENT || 'production' }}
+    steps:
+      - name: Dispatch deploy event
+        uses: actions/github-script@v7
         env:
-          # override the hostname set in `dev/environment`
-          DATABASE_URL: 'postgresql+psycopg://postgres@postgres/warehouse'
+          DEPLOY_REPOSITORY: ${{ vars.DEPLOY_REPOSITORY }}
+          DEPLOY_EVENT_TYPE: ${{ vars.DEPLOY_EVENT_TYPE || 'warehouse-deploy' }}
+          DEPLOY_ENVIRONMENT: ${{ vars.DEPLOY_ENVIRONMENT || 'production' }}
+          IMAGE_REF: ${{ needs.publish-image.outputs.image_ref }}
+          IMAGE_DIGEST: ${{ needs.publish-image.outputs.digest }}
+        with:
+          github-token: ${{ secrets.DEPLOY_REPOSITORY_TOKEN }}
+          script: |
+            const [owner, repo] = process.env.DEPLOY_REPOSITORY.split('/');
+            await github.rest.repos.createDispatchEvent({
+              owner,
+              repo,
+              event_type: process.env.DEPLOY_EVENT_TYPE,
+              client_payload: {
+                environment: process.env.DEPLOY_ENVIRONMENT,
+                image: process.env.IMAGE_REF,
+                digest: process.env.IMAGE_DIGEST,
+                source_repository: context.repo.owner + '/' + context.repo.repo,
+                source_sha: context.sha,
+              },
+            });
